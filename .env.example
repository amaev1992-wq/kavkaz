# Публичный URL страницы франшизы (используется для canonical / Open Graph).
# Примеры: https://franchise.kavkaz-autogas.ru или https://kavkaz-autogas.ru/franchise
NEXT_PUBLIC_SITE_URL=https://franchise.kavkaz-autogas.ru

# URL основного сайта компании (ссылка в footer).
NEXT_PUBLIC_MAIN_SITE_URL=https://kavkaz-autogas.ru

# Endpoint приёма заявок. По умолчанию — собственный API сайта (/api/lead),
# который шлёт письмо на почту компании. Задайте внешний URL, чтобы слать
# заявки напрямую в CRM. См. src/services/leads.ts и src/app/api/lead/route.ts
NEXT_PUBLIC_LEAD_API_ENDPOINT=

# --- Доставка заявок письмом (нужен ОДИН из способов) ---

# Способ 1 (рекомендуется): ключ web3forms.com — письма приходят на почту,
# к которой привязан ключ. Получение: web3forms.com → ввести email → ключ.
WEB3FORMS_ACCESS_KEY=

# Способ 2: прямая отправка через SMTP (Gmail app-пароль, Яндекс, Mail.ru).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
